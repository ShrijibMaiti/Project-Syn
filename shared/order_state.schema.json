{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYN Order State",
  "description": "The macroscopic order-parameter vector. Fixed dimension by construction: never per-entity microstate, whose dimension varies at runtime.",
  "type": "object",
  "required": ["t", "load", "queue_depth", "retry_rate", "error_rate"],
  "properties": {
    "t":             {"type": "number", "description": "seconds since run start"},
    "load":          {"type": "number", "minimum": 0, "description": "offered load (req/s)"},
    "queue_depth":   {"type": "number", "minimum": 0},
    "retry_rate":    {"type": "number", "minimum": 0},
    "error_rate":    {"type": "number", "minimum": 0, "maximum": 1},
    "cache_hit_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "latency_p50":   {"type": "number", "minimum": 0},
    "inflight":      {"type": "number", "minimum": 0},
    "commit":        {"type": "string"},
    "node":          {"type": "string"}
  },
  "additionalProperties": false
}